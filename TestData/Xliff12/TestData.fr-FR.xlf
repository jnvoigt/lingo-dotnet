<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.2"
       xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="sample.txt" source-language="en" target-language="fr-fr" datatype="plaintext">
        <body>
            <trans-unit id="sample.text.that-has-not-changed">
                <source>This is text A</source>
                <target>Ceci est le texte A</target>
            </trans-unit>
            <trans-unit id="sample.text.removed">
                <source>This is text B which is removed from source</source>
                <target>Ceci est le texte B qui est retiré de la source</target>
            </trans-unit>
            <trans-unit id="sample.text.changed">
                <source>This is text C with old content</source>
                <target>Ceci est le texte C avec l'ancien contenu</target>
            </trans-unit>
        </body>
    </file>
</xliff>
