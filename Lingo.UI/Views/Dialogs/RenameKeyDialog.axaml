<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lingo.UI.Views.Dialogs.RenameKeyDialog"
        Title="Rename Translation Key"
        Width="460" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="Rename Translation Key" FontWeight="Bold" FontSize="14" />
            
            <StackPanel Spacing="4">
                <TextBlock Text="Current Key:" FontSize="11" Opacity="0.7" />
                <TextBlock x:Name="CurrentKeyText" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="New Key Name:" FontSize="11" FontWeight="SemiBold" />
                <TextBox x:Name="NewKeyTextBox" PlaceholderText="Enter new key name..." />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#DC3545" FontSize="11" IsVisible="False" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Rename" Click="OnRenameClick" IsDefault="True" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
