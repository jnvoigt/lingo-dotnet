<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:files="using:Lingo.Core.Files"
        x:Class="Lingo.UI.Views.Dialogs.MoveKeyDialog"
        Title="Move Translation Key to Group"
        Width="480" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="Move Key to Translation Group" FontWeight="Bold" FontSize="14" />
            
            <StackPanel Spacing="4">
                <TextBlock Text="Key to Move:" FontSize="11" Opacity="0.7" />
                <TextBlock x:Name="KeyToMoveText" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Source Group:" FontSize="11" Opacity="0.7" />
                <TextBlock x:Name="CurrentGroupText" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Destination Group:" FontSize="11" FontWeight="SemiBold" />
                <ComboBox x:Name="TargetGroupComboBox" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="files:LoadedTranslationGroup">
                            <TextBlock Text="{Binding GroupStub, StringFormat='Group: {0}'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#DC3545" FontSize="11" IsVisible="False" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Move" Click="OnMoveClick" IsDefault="True" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
